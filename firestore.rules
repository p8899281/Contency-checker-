rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /students/{uid} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null && request.auth.uid == uid;
      allow delete: if true;
    }

    match /usernames/{studentId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if false;
      allow delete: if true;
    }

    match /counters/students {
      allow read: if true;
      allow write: if request.resource.data.keys().hasOnly(['count'])
                   && request.resource.data.count is int
                   && (!resource.data.keys().hasAny(['count']) || request.resource.data.count > resource.data.count);
    }

    match /focus_sounds/{soundId} {
      allow read: if true;
      allow write, delete: if true;
    }
  }
}
